# Matches ~/github/hangtiancheng/docker-compose.yml. Use a dedicated application DB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=pass
MYSQL_DB=raina
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Generate a secret with: openssl rand -hex 32
JWT_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_HOURS=168
# Persistent, writable directory; set an absolute path in production.
DATA_DIR=./data

# OpenAI-compatible ds-openai (chat) and ali-openai (embeddings); keys stay in Yukino config.
YUKINO_CONFIG_PATH=~/.yukino/config.yaml
